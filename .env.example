# Copy to .env (docker compose reads it automatically), then replace this value locally.
POSTGRES_PASSWORD=replace-with-a-local-password
# REQUIRED to change for anything other than local use. Generate one:  openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ENVIRONMENT=local            # 'production' REFUSES to boot with the default JWT secret
EXPORT_FAILURE_RATE=0.2      # set to 1 to watch the failure toast + retry flow
EXPORT_MAX_ATTEMPTS=3
